            return ParagraphFrame
        end
        
        -- INPUT
        function TabManager:AddInput(text, placeholder, callback)
            local InputFrame = Instance.new("Frame")
            InputFrame.Name = text
            InputFrame.Parent = TabContent
            InputFrame.BackgroundColor3 = Theme.SurfaceLight
            InputFrame.BorderSizePixel = 0
            InputFrame.Size = UDim2.new(1, 0, 0, 75)
            
            local InputCorner = Instance.new("UICorner")
            InputCorner.CornerRadius = UDim.new(0, 10)
            InputCorner.Parent = InputFrame
            
            local Label = Instance.new("TextLabel")
            Label.Parent = InputFrame
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 15, 0, 12)
            Label.Size = UDim2.new(1, -30, 0, 20)
            Label.Font = Enum.Font.GothamSemibold
            Label.Text = text
            Label.TextColor3 = Theme.Text
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local InputBox = Instance.new("TextBox")
            InputBox.Parent = InputFrame
            InputBox.BackgroundColor3 = Theme.Background
            InputBox.BorderSizePixel = 0
            InputBox.Position = UDim2.new(0, 15, 0, 40)
            InputBox.Size = UDim2.new(1, -30, 0, 28)
            InputBox.Font = Enum.Font.Gotham
            InputBox.PlaceholderText = placeholder or "Enter text..."
            InputBox.PlaceholderColor3 = Theme.TextMuted
            InputBox.Text = ""
            InputBox.TextColor3 = Theme.Text
            InputBox.TextSize = 13
            InputBox.TextXAlignment = Enum.TextXAlignment.Left
            InputBox.ClearTextOnFocus = false
            
            local BoxCorner = Instance.new("UICorner")
            BoxCorner.CornerRadius = UDim.new(0, 8)
            BoxCorner.Parent = InputBox
            
            local BoxStroke = Instance.new("UIStroke")
            BoxStroke.Parent = InputBox
            BoxStroke.Color = Theme.Border
            BoxStroke.Thickness = 1
            BoxStroke.Transparency = 0.5
            
            local BoxPadding = Instance.new("UIPadding")
            BoxPadding.Parent = InputBox
            BoxPadding.PaddingLeft = UDim.new(0, 12)
            BoxPadding.PaddingRight = UDim.new(0, 12)
            
            InputBox.Focused:Connect(function()
                Tween(BoxStroke, {Color = Theme.Primary, Thickness = 2, Transparency = 0}, 0.2)
            end)
            
            InputBox.FocusLost:Connect(function(enterPressed)
                Tween(BoxStroke, {Color = Theme.Border, Thickness = 1, Transparency = 0.5}, 0.2)
                if enterPressed then
                    pcall(callback, InputBox.Text)
                end
            end)
            
            InputFrame.MouseEnter:Connect(function()
                Tween(InputFrame, {BackgroundColor3 = Theme.Hover}, 0.2)
            end)
            
            InputFrame.MouseLeave:Connect(function()
                Tween(InputFrame, {BackgroundColor3 = Theme.SurfaceLight}, 0.2)
            end)
            
            return InputFrame
        end
        
        -- KEYBIND
        function TabManager:AddKeybind(text, defaultKey, callback)
            local currentKey = defaultKey or Enum.KeyCode.E
            local waitingForKey = false
            
            local KeybindFrame = Instance.new("Frame")
            KeybindFrame.Name = text
            KeybindFrame.Parent = TabContent
            KeybindFrame.BackgroundColor3 = Theme.SurfaceLight
            KeybindFrame.BorderSizePixel = 0
            KeybindFrame.Size = UDim2.new(1, 0, 0, 44)
            
            local KeyCorner = Instance.new("UICorner")
            KeyCorner.CornerRadius = UDim.new(0, 10)
            KeyCorner.Parent = KeybindFrame
            
            local Label = Instance.new("TextLabel")
            Label.Parent = KeybindFrame
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 15, 0, 0)
            Label.Size = UDim2.new(0.6, 0, 1, 0)
            Label.Font = Enum.Font.GothamSemibold
            Label.Text = text
            Label.TextColor3 = Theme.Text
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local KeyButton = Instance.new("TextButton")
            KeyButton.Parent = KeybindFrame
            KeyButton.BackgroundColor3 = Theme.Primary
            KeyButton.BorderSizePixel = 0
            KeyButton.Position = UDim2.new(1, -105, 0.5, -16)
            KeyButton.Size = UDim2.new(0, 95, 0, 32)
            KeyButton.Font = Enum.Font.GothamBold
            KeyButton.Text = currentKey.Name
            KeyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            KeyButton.TextSize = 13
            KeyButton.AutoButtonColor = false
            
            local KeyBtnCorner = Instance.new("UICorner")
            KeyBtnCorner.CornerRadius = UDim.new(0, 8)
            KeyBtnCorner.Parent = KeyButton
            
            KeyButton.MouseButton1Click:Connect(function()
                waitingForKey = true
                KeyButton.Text = "..."
            end)
            
            UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if waitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    KeyButton.Text = currentKey.Name
                    waitingForKey = false
                end
                
                if not gameProcessed and input.KeyCode == currentKey then
                    pcall(callback)
                    Tween(KeyButton, {BackgroundColor3 = Theme.Success}, 0.1)
                    wait(0.1)
                    Tween(KeyButton, {BackgroundColor3 = Theme.Primary}, 0.2)
                end
            end)
            
            KeybindFrame.MouseEnter:Connect(function()
                Tween(KeybindFrame, {BackgroundColor3 = Theme.Hover}, 0.2)
            end)
            
            KeybindFrame.MouseLeave:Connect(function()
                Tween(KeybindFrame, {BackgroundColor3 = Theme.SurfaceLight}, 0.2)
            end)
            
            return KeybindFrame
        end
        
        return TabManager
    end
    
    return WindowManager
end

return Library

