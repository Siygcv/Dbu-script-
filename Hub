                    SliderButton.Position = UDim2.new(pos, -10, 0.5, -10)
                    ValueLabel.Text = tostring(value)
                    
                    pcall(callback, value)
                end
            end)
            
            SliderFrame.MouseEnter:Connect(function()
                Tween(SliderFrame, {BackgroundColor3 = Theme.Hover}, 0.2)
            end)
            
            SliderFrame.MouseLeave:Connect(function()
                Tween(SliderFrame, {BackgroundColor3 = Theme.SurfaceLight}, 0.2)
            end)
            
            return SliderFrame
        end
        
        -- DROPDOWN
        function TabManager:AddDropdown(text, options, callback)
            local selected = options[1] or "None"
            local opened = false
            
            local DropdownFrame = Instance.new("Frame")
            DropdownFrame.Name = text
            DropdownFrame.Parent = TabContent
            DropdownFrame.BackgroundColor3 = Theme.SurfaceLight
            DropdownFrame.BorderSizePixel = 0
            DropdownFrame.Size = UDim2.new(1, 0, 0, 44)
            DropdownFrame.ClipsDescendants = true
            
            local DropCorner = Instance.new("UICorner")
            DropCorner.CornerRadius = UDim.new(0, 10)
            DropCorner.Parent = DropdownFrame
            
            local Label = Instance.new("TextLabel")
            Label.Parent = DropdownFrame
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 15, 0, 0)
            Label.Size = UDim2.new(0.5, -20, 0, 44)
            Label.Font = Enum.Font.GothamSemibold
            Label.Text = text
            Label.TextColor3 = Theme.Text
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local DropButton = Instance.new("TextButton")
            DropButton.Parent = DropdownFrame
            DropButton.BackgroundColor3 = Theme.Hover
            DropButton.BorderSizePixel = 0
            DropButton.Position = UDim2.new(0.5, 5, 0, 7)
            DropButton.Size = UDim2.new(0.5, -20, 0, 30)
            DropButton.Font = Enum.Font.Gotham
            DropButton.Text = selected
            DropButton.TextColor3 = Theme.Text
            DropButton.TextSize = 12
            DropButton.AutoButtonColor = false
            
            local DropBtnCorner = Instance.new("UICorner")
            DropBtnCorner.CornerRadius = UDim.new(0, 8)
            DropBtnCorner.Parent = DropButton
            
            local ChevronIcon = Instance.new("TextLabel")
            ChevronIcon.Parent = DropButton
            ChevronIcon.BackgroundTransparency = 1
            ChevronIcon.Position = UDim2.new(1, -20, 0, 0)
            ChevronIcon.Size = UDim2.new(0, 20, 1, 0)
            ChevronIcon.Font = Enum.Font.GothamBold
            ChevronIcon.Text = "▼"
            ChevronIcon.TextColor3 = Theme.Primary
            ChevronIcon.TextSize = 10
            
            local OptionsFrame = Instance.new("Frame")
            OptionsFrame.Parent = DropdownFrame
            OptionsFrame.BackgroundTransparency = 1
            OptionsFrame.Position = UDim2.new(0, 0, 0, 44)
            OptionsFrame.Size = UDim2.new(1, 0, 0, #options * 36)
            
            local OptionsList = Instance.new("UIListLayout")
            OptionsList.Parent = OptionsFrame
            OptionsList.SortOrder = Enum.SortOrder.LayoutOrder
            OptionsList.Padding = UDim.new(0, 4)
            
            local OptionsPadding = Instance.new("UIPadding")
            OptionsPadding.Parent = OptionsFrame
            OptionsPadding.PaddingLeft = UDim.new(0, 8)
            OptionsPadding.PaddingRight = UDim.new(0, 8)
            OptionsPadding.PaddingTop = UDim.new(0, 8)
            
            for _, option in ipairs(options) do
                local OptionBtn = Instance.new("TextButton")
                OptionBtn.Parent = OptionsFrame
                OptionBtn.BackgroundColor3 = Theme.Hover
                OptionBtn.BorderSizePixel = 0
                OptionBtn.Size = UDim2.new(1, 0, 0, 32)
                OptionBtn.Font = Enum.Font.Gotham
                OptionBtn.Text = option
                OptionBtn.TextColor3 = Theme.TextSecondary
                OptionBtn.TextSize = 12
                OptionBtn.AutoButtonColor = false
                
                local OptCorner = Instance.new("UICorner")
                OptCorner.CornerRadius = UDim.new(0, 8)
                OptCorner.Parent = OptionBtn
                
                OptionBtn.MouseButton1Click:Connect(function()
                    selected = option
                    DropButton.Text = selected
                    opened = false
                    Spring(DropdownFrame, {Size = UDim2.new(1, 0, 0, 44)}, 0.3)
                    Tween(ChevronIcon, {Rotation = 0}, 0.3)
                    pcall(callback, selected)
                end)
                
                OptionBtn.MouseEnter:Connect(function()
                    Tween(OptionBtn, {BackgroundColor3 = Theme.Primary}, 0.2)
                    Tween(OptionBtn, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.2)
                end)
                
                OptionBtn.MouseLeave:Connect(function()
                    Tween(OptionBtn, {BackgroundColor3 = Theme.Hover}, 0.2)
                    Tween(OptionBtn, {TextColor3 = Theme.TextSecondary}, 0.2)
                end)
            end
            
            DropButton.MouseButton1Click:Connect(function()
                opened = not opened
                if opened then
                    Spring(DropdownFrame, {Size = UDim2.new(1, 0, 0, 44 + #options * 36 + 12)}, 0.3)
                    Tween(ChevronIcon, {Rotation = 180}, 0.3)
                else
                    Spring(DropdownFrame, {Size = UDim2.new(1, 0, 0, 44)}, 0.3)
                    Tween(ChevronIcon, {Rotation = 0}, 0.3)
                end
            end)
            
            return DropdownFrame
        end
        
        -- LABEL
        function TabManager:AddLabel(text)
            local Label = Instance.new("TextLabel")
