-- SYSTÈME DE SAUVEGARDE GLOBAL
local SAVE_FILE = "WoWTeamHub_Settings.json"
_G.savedStates = _G.savedStates or {}

-- Chargement automatique au démarrage
local function loadStates()
    if isfile and readfile and isfile(SAVE_FILE) then
        local success, data = pcall(readfile, SAVE_FILE)
        if success then
            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, data)
            if ok and type(decoded) == "table" then
                _G.savedStates = decoded
                print("[WoW Hub] États chargés:", #decoded, "entrées")
            end
        end
    end
end

-- Sauvegarde automatique
local function saveStates()
    if writefile then
        local success, err = pcall(function()
            writefile(SAVE_FILE, HttpService:JSONEncode(_G.savedStates))
        end)
        if success then
            print("[WoW Hub] États sauvegardés")
        else
            warn("[WoW Hub] Erreur sauvegarde:", err)
        end
    end
end

